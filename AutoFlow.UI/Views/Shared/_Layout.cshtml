<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoFlow</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Ícones do Bootstrap (ótimo para colocar os ícones nos menus) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutoFlow.UI.styles.css" asp-append-version="true" />

</head>
<body>

    <div class="wrapper">
        <!-- BARRA LATERAL (SIDEBAR) -->
        <nav id="sidebar">
            <div class="sidebar-header d-flex align-items-center justify-content-between px-3 py-3">
                <div class="d-flex align-items-center overflow-hidden">
                    <i class="bi bi-car-front-fill fs-4 me-2 text-primary flex-shrink-0"></i>
                    <span class="menu-text fw-bold text-white text-nowrap">AUTOFLOW SaaS</span>
                </div>
            </div>

            <!-- Botão de Recolher/Expandir o Menu -->
            <div class="mt-3 mb-3 px-3 mb-2">
                <button id="btnToggleMenu" class="btn btn-sm text-white p-0 border-0" title="Recolher/Expandir Menu">
                    <i class="bi bi-list fs-4"></i>
                    <span class="menu-text ms-2 text-nowrap"> Recolher/Expandir Menu </span>
                </button>
            </div>

            <ul class="list-unstyled components px-4-menu-recolhido m-0">
                <li class="text-muted px-2 small fw-bold text-uppercase mb-2 menu-text">Painel Principal</li>
                <li class="mb-1">
                    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center text-decoration-none text-light py-2 px-2 rounded">
                        <i class="bi bi-speedometer2 fs-5 flex-shrink-0"></i>
                        <span class="menu-text ms-2 text-nowrap">Dashboard</span>
                    </a>
                </li>

                <li class="text-muted px-2 small fw-bold text-uppercase mt-4 mb-2 menu-text">Cadastros</li>
                <li class="mb-1">
                    <a asp-controller="Cliente" asp-action="Index" class="d-flex align-items-center text-decoration-none text-light py-2 px-2 rounded">
                        <i class="bi bi-people-fill fs-5 flex-shrink-0"></i>
                        <span class="menu-text ms-2 text-nowrap">Clientes</span>
                    </a>
                </li>
                <li class="mb-1">
                    <a href="#" class="d-flex align-items-center text-decoration-none text-light py-2 px-2 rounded">
                        <i class="bi bi-truck fs-5 flex-shrink-0"></i>
                        <span class="menu-text ms-2 text-nowrap">Veículos</span>
                    </a>
                </li>
                <li class="mb-1">
                    <a href="#" class="d-flex align-items-center text-decoration-none text-light py-2 px-2 rounded">
                        <i class="bi bi-tools fs-5 flex-shrink-0"></i>
                        <span class="menu-text ms-2 text-nowrap">Serviços</span>
                    </a>
                </li>

                <li class="text-muted px-2 small fw-bold text-uppercase mt-4 mb-2 menu-text">Sistema</li>
                <li class="mb-1">
                    <a asp-controller="Home" asp-action="Privacy" class="d-flex align-items-center text-decoration-none text-light py-2 px-2 rounded">
                        <i class="bi bi-shield-lock fs-5 flex-shrink-0"></i>
                        <span class="menu-text ms-2 text-nowrap">Privacidade</span>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- ÁREA DE CONTEÚDO PRINCIPAL -->
        <div id="content">
            <!-- Navbar Superior -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm rounded mb-4 px-4">
                <div class="container-fluid">
                    <span class="navbar-text fw-bold color-text-padrao">
                        Painel Administrativo da Oficina
                    </span>
                    <div class="collapse navbar-collapse justify-content-end">
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle color-text-padrao fw-bold" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 me-1"></i> Administrador
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Container Global para Alertas Flutuantes (Toasts/Alertas) -->
            <div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;">
                <div id="toast-container"></div>
            </div>

            <!-- Onde o conteúdo das outras telas (como a lista de clientes) é injetado -->
            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Scripts padrão -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>