@{
    ViewData["Title"] = "Lista de Clientes";
}

<div class="container mt-4">
    <h2>Lista de Clientes Cadastrados</h2>
    <hr />

    <!-- Tabela onde os dados da API vão aparecer -->
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Telefone/WhatsApp</th>
                <th>Documento</th>
            </tr>
        </thead>
        <tbody id="tabela-clientes">
            <!-- O JavaScript vai injetar as linhas dos clientes aqui dentro dinamicamente! -->
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/cliente/cliente-index.js"></script>
}