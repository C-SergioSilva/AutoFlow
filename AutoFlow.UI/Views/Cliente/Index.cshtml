@{
    ViewData["Title"] = "Gerenciamento de Clientes";
}

<div class="container-fluid mt-4">
    <!-- Cabeçalho da Página com Título e Botão de Novo Cliente -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold mb-1">Painel de Clientes</h2>
            <p class="text-muted small mb-0">Gerencie a base de clientes da oficina em formato de tickets rápidos.</p>
        </div>
        <!-- Botão que aciona o Modal de Cadastro -->
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCliente">
            <i class="bi bi-plus-lg me-1"></i> Novo Cliente
        </button>
    </div>

    <hr class="mb-4" />

    <!-- CONTAINER DOS TICKETS -->
    <div class="row g-3" id="container-clientes">
        <!-- Card de Exemplo (Enquanto a API não responde) -->
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100 border-start border-primary border-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title fw-bold text-dark mb-0">Carregando clientes...</h5>
                        <span class="badge bg-light text-secondary">#ID</span>
                    </div>
                    <p class="card-text text-muted small mb-2">
                        <i class="bi bi-whatsapp text-success me-1"></i> (00) 00000-0000
                    </p>
                    <p class="card-text text-muted small mb-3">
                        <i class="bi bi-card-text text-secondary me-1"></i> Doc: 000.000.000-00
                    </p>
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <button class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL DE CADASTRO DE CLIENTE (Padronizado) -->
<!-- ========================================== -->
<div class="modal fade" id="modalCliente" tabindex="-1" aria-labelledby="modalClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <!-- Cabeçalho com cor primária alinhada ao tema -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalClienteLabel">
                    <i class="bi bi-person-plus-fill me-2"></i> Cadastrar Novo Cliente
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formCliente">
                    <div class="mb-3">
                        <label for="nome" class="form-label fw-semibold text-secondary">Nome Completo / Razão Social</label>
                        <input type="text" class="form-control" id="nome" required placeholder="Ex: Oficina Mecânica Silva">
                    </div>
                    <div class="mb-3">
                        <label for="telefone" class="form-label fw-semibold text-secondary">Telefone / WhatsApp</label>
                        <input type="text" class="form-control" id="telefone" required placeholder="(85) 99999-9999">
                    </div>
                    <div class="mb-3">
                        <label for="documento" class="form-label fw-semibold text-secondary">Documento (CPF / CNPJ)</label>
                        <input type="text" class="form-control" id="documento" required placeholder="000.000.000-00">
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary px-4" id="btnSalvarCliente">Salvar Cliente</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/cliente/cliente-index.js" asp-append-version="true"></script>
}